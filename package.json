{
  "name": "ringkasku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "tsc && vite build --mode pages",
    "deploy": "npm run build:pages && gh-pages -d dist",
    "preview": "vite preview"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  },
  "description": "Ringkasku — offline-first Indonesian text summarizer using Firebase AI Logic hybrid inference (Gemini Nano on-device + Gemini cloud fallback).",
