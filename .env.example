# Ringkasku — Firebase web app configuration.
# Copy this file to ".env" and fill in the values from your Firebase project:
# Firebase console > Project settings > General > "Your apps" > Web app.
#
# These are public client identifiers for a Firebase web app (they identify
# the project; access is controlled by Firebase App Check and API restrictions,
# not by keeping them secret). The local ".env" file is gitignored anyway.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: reCAPTCHA Enterprise site key used by Firebase App Check in
# production builds. For local development you do NOT need this — the app
# enables the App Check debug provider automatically in dev mode
# (see README, "App Check" section).
VITE_FIREBASE_APPCHECK_SITE_KEY=
